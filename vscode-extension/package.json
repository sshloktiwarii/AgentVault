{
  "name": "agentvault-vscode",
  "displayName": "AgentVault: AI Safety Net",
  "description": "Native UI for AgentVault atomic rollbacks and transaction history.",
  "version": "1.0.0",
  "publisher": "AgentVault",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shlok04423/agentvault"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentvault.restore",
        "title": "Restore AgentVault Checkpoint",
        "icon": "$(history)"
      },
      {
        "command": "agentvault.refresh",
        "title": "Refresh Timeline",
        "icon": "$(refresh)"
      }
    ],
    "timeline": [
      {
        "id": "agentvault-timeline",
        "label": "AgentVault Recovery"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.1.3"
  }
}
