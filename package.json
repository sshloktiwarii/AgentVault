{
  "name": "agentvault",
  "version": "4.0.0",
  "description": "AgentVault: Zero-configuration flight recorder and transaction-rollback hypervisor for CLI coding agents",
  "main": "dist/index.js",
  "bin": {
    "agentvault": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:ast": "jest tests/ast",
    "test:fuzz": "jest tests/fuzz --runInBand --detectOpenHandles",
    "test:cluster": "jest tests/cluster --runInBand --detectOpenHandles",
    "test:all": "jest --runInBand --detectOpenHandles",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "agent",
    "rollback",
    "flight-recorder",
    "claude",
    "aider",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "node-addon-api": "^8.9.2",
    "node-pty": "^1.1.0",
    "pm2": "^7.0.4",
    "react": "^19.3.0",
    "ts-morph": "^28.0.0",
    "uint8arrays": "^6.1.1",
    "uuid": "^14.0.2",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.2",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
